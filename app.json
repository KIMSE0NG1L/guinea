{
  "expo": {
    "name": "기니 키우기",
    "slug": "gini_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.guinea.adventure",
      "supportsTablet": true,
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FCEFC7",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.guinea.adventure",
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/app-icon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/Maplestory-Bold.ttf",
              "./assets/fonts/Maplestory-Light.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Maplestory-Bold",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Maplestory-Bold.ttf", "weight": 400 },
                  { "path": "./assets/fonts/Maplestory-Bold.ttf", "weight": 500 },
                  { "path": "./assets/fonts/Maplestory-Bold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/Maplestory-Bold.ttf", "weight": 700 },
                  { "path": "./assets/fonts/Maplestory-Bold.ttf", "weight": 800 },
                  { "path": "./assets/fonts/Maplestory-Bold.ttf", "weight": 900 }
                ]
              },
              {
                "fontFamily": "Maplestory-Light",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Maplestory-Light.ttf", "weight": 300 },
                  { "path": "./assets/fonts/Maplestory-Light.ttf", "weight": 400 },
                  { "path": "./assets/fonts/Maplestory-Light.ttf", "weight": 700 }
                ]
              }
            ]
          }
        }
      ],
      "expo-audio",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCEFC7",
          "image": "./assets/app-icon.png",
          "resizeMode": "contain",
          "imageWidth": 220
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7612859698236948~6928355401",
          "iosAppId": "ca-app-pub-7612859698236948~9460196159"
        }
      ]
    ]
  }
}
