# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Play Store upload keystore + its password/cert — never commit signing material
/guinea-keystore/

# Local Gradle cache (dependencies + provisioned JDK) — large, machine-local, regenerable
/.gradle-cache/

# redundant archive of assets/sprites
assets/sprites.zip

# Claude Code personal settings
.claude/settings.local.json
